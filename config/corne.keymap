#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    combos {
        compatible = "zmk,combos";

        escape {
            bindings = <&kp ESC>;
            key-positions = <4 16>;
        };
    };

    behaviors {
        shift_dance: shift_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFT_DANCE";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPSLOCK>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB       &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y    &kp U  &kp I           &kp O    &kp P     &kp BACKSPACE
&shift_dance  &kp A  &kp S  &kp D     &kp F  &kp G        &kp H    &kp J  &kp K           &kp L    &kp SEMI  &kp SQT
&kp LCTRL     &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N    &kp M  &kp COMMA       &kp DOT  &kp FSLH  &kp ESC
                            &kp LGUI  &sl 2  &kp SPACE    &kp RET  &mo 1  &sk LEFT_SHIFT
            >;
        };

        num_and_nav {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp DELETE  &kp N1  &kp N2  &kp N3    &kp N4  &kp N5       &kp N6          &kp N7    &kp N8        &kp N9     &kp N0  &kp BSPC
&trans      &trans  &trans  &trans    &trans  &trans       &kp LEFT_ARROW  &kp DOWN  &kp UP_ARROW  &kp RIGHT  &trans  &kp DEL
&kp LCTRL   &trans  &trans  &trans    &trans  &trans       &trans          &trans    &trans        &trans     &trans  &trans
                            &kp LGUI  &sl 3   &kp SPACE    &kp RET         &trans    &kp RALT
            >;
        };

        specialchars {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &kp EXCL       &kp AT            &kp HASH              &kp DLLR               &kp PRCNT    &kp CARET  &kp AMPS          &kp ASTRK          &trans         &trans    &kp BSPC
&trans  &kp LESS_THAN  &kp GREATER_THAN  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EQUAL    &kp MINUS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SEMICOLON  &kp BSLH  &kp GRAVE
&trans  &trans         &trans            &trans                &kp SLASH              &kp PLUS     &kp UNDER  &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp COLON      &kp PIPE  &kp TILDE
                                         &kp LGUI              &trans                 &kp SPACE    &kp RET    &sl 3             &kp RALT
            >;
        };

        media {
            bindings = <
&trans  &kp NUMBER_1     &kp NUMBER_2     &kp NUMBER_3     &kp NUMBER_4     &kp N5             &kp NUMBER_6      &kp N7        &kp N8           &kp N9      &kp N0  &trans
&trans  &trans           &trans           &bl BL_DEC       &bl BL_INC       &bl BL_TOG         &kp K_PLAY_PAUSE  &kp C_VOL_DN  &kp C_VOLUME_UP  &kp K_MUTE  &trans  &trans
&trans  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &rgb_ug RGB_TOG    &trans            &trans        &trans           &trans      &trans  &trans
                                          &trans           &trans           &trans             &trans            &trans        &trans
            >;
        };

        symbols_backupp {
            bindings = <
&kp TAB    &kp EXCL  &kp AT  &kp HASH  &kp DLLR       &kp PRCNT           &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&trans     &trans    &trans  &trans    &kp LESS_THAN  &kp GREATER_THAN    &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&kp LCTRL  &trans    &trans  &trans    &trans         &trans              &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                             &kp LGUI  &trans         &kp SPACE           &kp RET    &mo 3      &kp RALT
            >;
        };
    };
};

//adjust the length of per side led strip

&led_strip {
    // 21 + 6

    chain-length = <27>;
};
